# Copy to .env and adjust. All values have safe defaults in src/config/env.js.
PORT=3000

# MySQL (database and tables are created automatically on boot)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=factory_traffic

# MQTT: leave MQTT_URL empty to start the embedded aedes broker on MQTT_PORT
MQTT_PORT=1883
MQTT_URL=

# Runtime
TICK_MS=250
START_SIMULATOR=true
